model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart          Cart?
  orders        Order[]
  addresses     Address[]
  reviews       Review[]       @relation("UserReviews")
  wishlistItems WishlistItem[]

  @@index([email])
}
